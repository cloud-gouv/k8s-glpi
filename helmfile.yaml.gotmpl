environments:
  dev: {}
  ppr: {}

---

repositories:
  - name: eftechcombr
    url: https://eftechcombr.github.io/glpi/

releases:
  - name: glpi
    namespace: {{ .Namespace }}
    chart: eftechcombr/glpi
    version: 2.12.0
    missingFileHandler: Warn
    values:
      - common/values.yaml
      - env/{{ .Environment.Name }}/values.yaml
    secrets:
      - env/{{ .Environment.Name }}/secrets.enc.yaml
    strategicMergePatches:
      - common/patch-affinities.yaml.gotmpl
      - common/patch-resources.yaml.gotmpl
      - common/patch-securitycontexts.yaml.gotmpl

  - name: glpi-extra
    namespace: {{ .Namespace }}
    chart: extra
    values:
      - env/{{ .Environment.Name }}/values.yaml
