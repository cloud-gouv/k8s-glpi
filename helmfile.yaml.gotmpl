environments:
  dev: {}
  ppr: {}
---
repositories:
  - name: eftechcombr
    url: https://eftechcombr.github.io/glpi/
---
releases:
  - name: glpi
    namespace: {{ .Namespace }}
    chart: eftechcombr/glpi
    version: 2.12.0
    missingFileHandler: Warn
    values:
      - env/common/values.yaml
      - env/{{ .Environment.Name }}/values.yaml
    secrets:
      - env/{{ .Environment.Name }}/secrets.enc.yaml
    strategicMergePatches:
      - env/common/patch-affinities.yaml.gotmpl
      - env/common/patch-resources.yaml.gotmpl
      - env/common/patch-securitycontexts.yaml.gotmpl
